#!/usr/bin/env bash
# .githooks/pre-push
#
# Full quality gate — format + lint + typecheck + tests + build.
# Runs automatically before every push.
# Skip with: git push --no-verify
#
# Setup (one-time): bash scripts/setup_hooks.sh

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

exec bash docker/scripts/ci_full.sh
