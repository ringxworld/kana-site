# Copy to docker/.env (gitignored) and fill in real values.
# docker/.env is automatically loaded by docker compose when using
#   docker compose -f docker/docker-compose.yml ...

# GitHub Personal Access Token — shared by all self-hosted CI runner containers.
# Scopes required: repo  (or public_repo if all repos are public)
# Create at: https://github.com/settings/tokens/new
# The token auto-generates a fresh runner registration token on every container
# start — no stale RUNNER_TOKEN, no manual re-setup after recreations.
GH_PAT=ghp_xxxx
