FROM node:24-slim

ENV NODE_ENV=ci \
    KANA_CI_CONTAINER=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Node dep cache layer — reinstalled only when package-lock.json changes
COPY package.json package-lock.json /app/
RUN npm ci

# Runtime: volume mount provides live source code
