{
  "name": "kotoba-lab",
  "version": "1.0.0",
  "description": "Browser Japanese IME using kuromoji + SKK dictionary",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "vendor:sync": "npx shx mkdir -p client/public/vendor/kuromoji client/public/vendor/ipadic && npx shx cp node_modules/kuromoji/build/kuromoji.js client/public/vendor/kuromoji/ && npx shx cp -r node_modules/kuromoji/dict/* client/public/vendor/ipadic/",
    "fetch:skk": "npx shx mkdir -p client/public/dict && curl -L -o client/public/dict/SKK-JISYO.L https://skk-dev.github.io/dict/SKK-JISYO.L",
    "setup": "npm run vendor:sync && npm run fetch:skk",
    "format": "prettier --write .",
    "lint": "eslint \"client/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"client/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "wanakana": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "connect-history-api-fallback": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.0.0",
    "serve-static": "^2.2.0",
    "shx": "^0.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "@playwright/test": "^1.50.0"
  }
}
